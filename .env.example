# ---------------------------------------------------------------------------
# CauseTrace environment configuration
# Copy this file to `.env` and fill in what you need. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
#   mock   = deterministic test double (no network, no cost). Default.
#   gemini = REAL gemini-3.6-flash via Google AI Studio (free tier, no card)
#   github = gpt-4o-mini via GitHub Models (IN RETIREMENT BROWNOUT - avoid)
#   openai = gpt-4o-mini via platform.openai.com (pay-as-you-go)
LLM_PROVIDER=gemini

# Needed only when LLM_PROVIDER=gemini
# Create at: https://aistudio.google.com/apikey  (new-format AQ.* keys work)
GEMINI_API_KEY=

# Optional: primary model override (default gemini-3.6-flash). If the free
# tier's per-model daily quota is hit, the engine degrades through
# gemini-flash-latest -> gemini-flash-lite-latest automatically.
# LLM_MODEL=gemini-3.6-flash

# Completion-token cap per call (thinking models spend from this budget).
# LLM_MAX_TOKENS=3072

# Needed only when LLM_PROVIDER=openai (or github during its brownout windows)
OPENAI_API_KEY=
GITHUB_TOKEN=

# --- Demo clock --------------------------------------------------------------
# Freshness checks are evaluated against this frozen timestamp so the demo
# behaves identically forever. Leave empty to auto-use the newest data date.
DEMO_NOW=2026-07-30

# --- Test isolation ----------------------------------------------------------
# Override the DuckDB path so test runs never contend with a live server:
# DUCKDB_PATH=C:\temp\causetrace_test.duckdb

# --- Server -------------------------------------------------------------------
API_PORT=8000
